#!/usr/bin/env python3
"""agent-skills CLI — 定向筛选 / 导出挂载 / 入库校验 / 使用记录 / 交付台账 / 漂移检测

零依赖，单文件。仓库根目录执行：

  ./skills-cli list                          # 列出全部技能
  ./skills-cli list --platform xiaohongshu   # 定向：只看小红书技能
  ./skills-cli list --category coding --json # 机器可读输出

  ./skills-cli export --platform xiaohongshu --to ~/.claude/skills
  ./skills-cli export --skills wuxia-cinematic,keyring --to ./out
  ./skills-cli export --category image-gen --zip xiaohongshu-pack.zip
  ./skills-cli export --skills browser-verify --to .claude/skills,.codex/skills   # 一次导出多个目标
  ./skills-cli export --skills browser-verify --to ~/.claude/skills --tool claude # 套用 claude 专属 overlay

  ./skills-cli check                         # 入库规范校验（SKILL-SPEC.md 的执行器），含质量追踪 JSON 校验
  ./skills-cli check --skills wuxia-cinematic # 只查指定技能（pre-commit hook 用这个做 diff-only 校验）
  ./skills-cli stats                         # 使用记录总览：按 last_used 排序，标出缺记录的技能
  ./skills-cli drift --to ~/.claude/skills   # 对比 已安装副本 vs 仓库源 vs 交付基线，抓漂移/冲突
  ./skills-cli log                           # 查看交付记录（delivery-log.jsonl）

platform 取值: xiaohongshu | wechat | wechat-video | shared（shared=多平台通用）
定向筛选时 shared 技能默认包含在任何平台结果里（--strict 关闭该行为）。

Frontmatter 可选嵌套 overlays 块，声明按目标工具覆盖的字段（export --tool 时套用，
其余情况下整段 overlays 会从导出副本里剥离，不污染消费方 frontmatter）：

  overlays:
    claude:
      model: claude-sonnet-5
    codex:
      reasoning_effort: high
"""

import argparse, datetime, getpass, hashlib, json, os, re, shutil, socket, sys, tempfile, zipfile
from pathlib import Path

ROOT = Path(__file__).resolve().parent
SKILLS_DIR = ROOT / 'skills'
LOG_FILE = ROOT / 'delivery-log.jsonl'

REQUIRED_KEYS = ('name', 'description', 'type', 'category', 'platform')
PLATFORMS = ('xiaohongshu', 'wechat', 'wechat-video', 'shared')
CATEGORIES = ('image-gen', 'coding', 'video-gen', 'meta')


def parse_frontmatter(path: Path) -> dict:
    text = path.read_text(encoding='utf-8')
    m = re.match(r'^---\n(.*?)\n---', text, re.S)
    if not m:
        return {}
    fm = {}
    in_metadata = False
    for line in m.group(1).splitlines():
        nested = re.match(r'^\s{2}([A-Za-z_][A-Za-z0-9_-]*):\s*(.*)$', line)
        if in_metadata and nested:
            fm[nested.group(1)] = nested.group(2).strip().strip('"')
            continue
        kv = re.match(r'^([A-Za-z_][A-Za-z0-9_-]*):\s*(.*)$', line)
        if kv:
            key, value = kv.group(1), kv.group(2).strip().strip('"')
            in_metadata = key == 'metadata' and not value
            if key != 'metadata':
                fm[key] = value
        elif line.strip():
            in_metadata = False
    return fm


def parse_overlays(path: Path) -> dict:
    """解析 frontmatter 里的 overlays: 嵌套块 → {tool: {key: value}}。"""
    if not path.exists():
        return {}
    text = path.read_text(encoding='utf-8')
    m = re.match(r'^---\n(.*?)\n---', text, re.S)
    if not m:
        return {}
    overlays, cur_tool, in_overlays = {}, None, False
    for line in m.group(1).splitlines():
        if re.match(r'^overlays:\s*$', line):
            in_overlays, cur_tool = True, None
            continue
        if not in_overlays:
            continue
        if not line.strip():
            continue
        tool_m = re.match(r'^  ([A-Za-z_][\w-]*):\s*$', line)
        kv_m = re.match(r'^    ([A-Za-z_][\w-]*):\s*(.*)$', line)
        if tool_m:
            cur_tool = tool_m.group(1)
            overlays[cur_tool] = {}
        elif kv_m and cur_tool:
            overlays[cur_tool][kv_m.group(1)] = kv_m.group(2).strip().strip('"')
        elif not line.startswith('  '):
            in_overlays, cur_tool = False, None
    return overlays


def strip_block(fm_lines: list, key: str) -> list:
    out, skipping = [], False
    for line in fm_lines:
        if re.match(rf'^{re.escape(key)}:\s*$', line):
            skipping = True
            continue
        if skipping:
            if line.startswith('  ') or not line.strip():
                continue
            skipping = False
        out.append(line)
    return out


def render_for_tool(skill_md: Path, overlay: dict, tool):
    """从导出副本剥离 overlays 声明块；若指定 --tool 且该技能声明了对应 overlay，套用其字段覆盖。"""
    text = skill_md.read_text(encoding='utf-8')
    m = re.match(r'^---\n(.*?)\n---\n?(.*)$', text, re.S)
    if not m:
        return
    fm_lines = strip_block(m.group(1).splitlines(), 'overlays')
    for key, val in (overlay.get(tool) or {}).items():
        pattern = re.compile(rf'^{re.escape(key)}:\s*.*$')
        for i, line in enumerate(fm_lines):
            if pattern.match(line):
                fm_lines[i] = f'{key}: {val}'
                break
        else:
            fm_lines.append(f'{key}: {val}')
    skill_md.write_text('---\n' + '\n'.join(fm_lines) + '\n---\n' + m.group(2), encoding='utf-8')


def hash_dir(path: Path) -> str:
    h = hashlib.sha256()
    for f in sorted(path.rglob('*')):
        if f.is_file():
            h.update(f.relative_to(path).as_posix().encode()); h.update(b'\0')
            h.update(f.read_bytes()); h.update(b'\0')
    return h.hexdigest()[:16]


def ts_now() -> str:
    return datetime.datetime.now().astimezone().isoformat(timespec='seconds')


def whoami() -> str:
    return f'{getpass.getuser()}@{socket.gethostname()}'


def extract_tracking(text: str):
    """从正文提取质量追踪 JSON。兼容两种写法：<!-- tracking {...} --> 或裸 JSON 块。"""
    m = re.search(r'<!--\s*tracking\s*(\{.*?\})\s*-->', text, re.S)
    if m:
        return m.group(1)
    for m in re.finditer(r'\{(?:[^{}]|\{[^{}]*\})*\}', text, re.S):
        blob = m.group(0)
        if '"status"' in blob and '"trace"' in blob:
            return blob
    return None


TRACKING_KEYS = ('status', 'rating', 'last_used', 'total_uses', 'trace')
TRACKING_STATUS = ('draft', 'tested', 'production')


def check_tracking(tag: str, body: str, fails: list, warns: list):
    blob = extract_tracking(body)
    if blob is None:
        warns.append(f'{tag}: 缺质量追踪 JSON（建议记录 status/rating/last_used/total_uses/trace，见 SKILL-SPEC.md）')
        return
    try:
        data = json.loads(blob)
    except json.JSONDecodeError as e:
        fails.append(f'{tag}: 质量追踪 JSON 格式错误（{e}）')
        return
    missing = [k for k in TRACKING_KEYS if k not in data]
    if missing:
        fails.append(f"{tag}: 质量追踪 JSON 缺字段 {', '.join(missing)}")
        return
    issues = []
    if data.get('status') not in TRACKING_STATUS:
        issues.append(f"status={data.get('status')!r} 应为 {'/'.join(TRACKING_STATUS)}")
    if not re.fullmatch(r'[★☆]{5}', str(data.get('rating', ''))):
        issues.append(f"rating={data.get('rating')!r} 格式非法")
    if not re.fullmatch(r'\d{4}-\d{2}-\d{2}', str(data.get('last_used', ''))):
        issues.append(f"last_used={data.get('last_used')!r} 非 YYYY-MM-DD")
    if not isinstance(data.get('total_uses'), int):
        issues.append(f"total_uses={data.get('total_uses')!r} 非整数")
    if not isinstance(data.get('trace'), list) or not data['trace']:
        issues.append('trace 为空或非数组')
    if issues:
        warns.append(f"{tag}: 质量追踪 JSON 内容可疑 — {'; '.join(issues)}（如实填写，非占位符）")


def load_skills() -> list:
    out = []
    for d in sorted(SKILLS_DIR.iterdir()):
        if not d.is_dir():
            continue
        f = d / 'SKILL.md'
        fm = parse_frontmatter(f) if f.exists() else {}
        out.append({'dir': d.name, 'path': d, 'fm': fm, 'has_skill_md': f.exists()})
    return out


def matches(s, args) -> bool:
    fm = s['fm']
    if args.skills:
        return s['dir'] in {x.strip() for x in args.skills.split(',')}
    if args.platform:
        plat = fm.get('platform', '')
        ok = plat == args.platform or (not args.strict and plat == 'shared')
        if not ok:
            return False
    if args.category and fm.get('category', '') != args.category:
        return False
    return True


def cmd_list(args):
    rows = [s for s in load_skills() if matches(s, args)]
    if args.json:
        print(json.dumps([
            {'name': s['dir'], **{k: s['fm'].get(k, '') for k in ('zh_name', 'category', 'platform', 'type', 'description')}}
            for s in rows], ensure_ascii=False, indent=2))
        return
    if not rows:
        print('无匹配技能'); return
    w = max(len(s['dir']) for s in rows)
    for s in rows:
        fm = s['fm']
        print(f"{s['dir']:<{w}}  {fm.get('category', '?'):<9} {fm.get('platform', '?'):<12} {fm.get('zh_name', '')}")
    print(f"\n共 {len(rows)} 个")


def cmd_export(args):
    if not (args.skills or args.platform or args.category):
        sys.exit('export 需要至少一个筛选条件（--skills / --platform / --category），拒绝全量误导出')
    rows = [s for s in load_skills() if matches(s, args)]
    if not rows:
        sys.exit('无匹配技能，未导出')
    if not args.to and not args.zip:
        sys.exit('export 需要 --to <目录>（可逗号分隔多个）或 --zip <文件>')

    names = [s['dir'] for s in rows]
    filt = {k: v for k, v in (('platform', args.platform), ('category', args.category), ('skills', args.skills)) if v}
    entries = []

    if args.zip:
        zpath = Path(args.zip).expanduser().resolve()
        with zipfile.ZipFile(zpath, 'w', zipfile.ZIP_DEFLATED) as z:
            for s in rows:
                for f in sorted(s['path'].rglob('*')):
                    if f.is_file():
                        z.write(f, f.relative_to(SKILLS_DIR))
        print(f"✅ 打包 {len(names)} 个技能 → {zpath}")
        entries.append({'ts': ts_now(), 'action': 'export', 'skills': names, 'target': str(zpath), 'filter': filt, 'by': whoami()})

    if args.to:
        for target in (t.strip() for t in args.to.split(',') if t.strip()):
            dest = Path(target).expanduser().resolve()
            dest.mkdir(parents=True, exist_ok=True)
            hashes = {}
            for s in rows:
                dest_skill = dest / s['dir']
                shutil.copytree(s['path'], dest_skill, dirs_exist_ok=True)
                skill_md = dest_skill / 'SKILL.md'
                if skill_md.exists():
                    render_for_tool(skill_md, parse_overlays(s['path'] / 'SKILL.md'), args.tool)
                hashes[s['dir']] = hash_dir(dest_skill)
            suffix = f'（tool={args.tool}）' if args.tool else ''
            print(f"✅ 导出 {len(names)} 个技能 → {dest}{suffix}")
            for n in names:
                print('  ·', n)
            entry = {'ts': ts_now(), 'action': 'export', 'skills': names, 'target': str(dest), 'filter': filt, 'by': whoami(), 'hashes': hashes}
            if args.tool:
                entry['tool'] = args.tool
            entries.append(entry)

    if not args.no_log:
        with LOG_FILE.open('a', encoding='utf-8') as fp:
            for e in entries:
                fp.write(json.dumps(e, ensure_ascii=False) + '\n')
        print(f"📒 已记录交付台账 {LOG_FILE.name}")


def cmd_check(args):
    fails, warns = [], []
    all_skills = load_skills()
    scoped = bool(args.skills or args.platform or args.category)
    rows = [s for s in all_skills if matches(s, args)] if scoped else all_skills
    for s in rows:
        tag = s['dir']
        if not s['has_skill_md']:
            fails.append(f'{tag}: 缺 SKILL.md（规范要求唯一入口）'); continue
        fm = s['fm']
        for k in REQUIRED_KEYS:
            if not fm.get(k):
                fails.append(f'{tag}: frontmatter 缺 {k}')
        if fm.get('name') and fm['name'] != tag:
            fails.append(f"{tag}: name 字段({fm['name']}) 与目录名不一致")
        if fm.get('platform') and fm['platform'] not in PLATFORMS:
            fails.append(f"{tag}: platform 值非法({fm['platform']})，应为 {'|'.join(PLATFORMS)}")
        if fm.get('category') and fm['category'] not in CATEGORIES:
            fails.append(f"{tag}: category 值非法({fm['category']})，应为 {'|'.join(CATEGORIES)}")

        body = (s['path'] / 'SKILL.md').read_text(encoding='utf-8')
        check_tracking(tag, body, fails, warns)

        if fm.get('category') == 'coding' and not fm.get('version'):
            warns.append(f'{tag}: coding 类技能建议声明 version 字段（追踪版本迭代）')

        if fm.get('category') == 'image-gen':
            has_local = any((s['path'] / f'sample-output{ext}').exists() for ext in ('.jpg', '.png', '.jpeg', '.webp'))
            has_remote = bool(re.search(r'\]\(https?://\S+\.(?:jpe?g|png|webp|gif)\)', body, re.I))
            if not (has_local or has_remote):
                warns.append(f'{tag}: 缺样图（本地 sample-output.* 或正文里指向 R2 的图片链接，二选一）')
            # 出图类 = 纯提示词模板，禁止出现系统命令行（cs/wrangler/npx 等对用户无意义）
            hits = sorted(set(re.findall(r'\bcs\s+(?:image|db|secrets|task|board)\b|\bwrangler\s+\w+|\bnpx\s+[\w-]+', body)))
            if hits:
                fails.append(f"{tag}: 出图类技能禁止包含系统命令行（发现: {', '.join(hits[:3])}）——纯提示词模板即可")

    for f in fails:
        print('❌', f)
    for w in warns:
        print('⚠️ ', w)
    total = len(rows)
    print(f'\n{total} 个技能：{total - len({f.split(":")[0] for f in fails})} 通过，{len(fails)} 项硬伤，{len(warns)} 项警告')
    sys.exit(1 if fails else 0)


def cmd_stats(args):
    """使用记录总览：按 last_used 由旧到新排序，缺质量追踪块的排最前面（最该补）。"""
    rows = [s for s in load_skills() if s['has_skill_md'] and matches(s, args)]
    parsed = []
    for s in rows:
        body = (s['path'] / 'SKILL.md').read_text(encoding='utf-8')
        blob = extract_tracking(body)
        data = None
        if blob:
            try:
                data = json.loads(blob)
            except json.JSONDecodeError:
                data = None
        parsed.append((s['dir'], data))

    parsed.sort(key=lambda x: (x[1] or {}).get('last_used') or '')

    if args.json:
        print(json.dumps([
            {'name': name, 'status': (d or {}).get('status'), 'rating': (d or {}).get('rating'),
             'last_used': (d or {}).get('last_used'), 'total_uses': (d or {}).get('total_uses')}
            for name, d in parsed], ensure_ascii=False, indent=2))
        return

    missing = [name for name, d in parsed if d is None]
    w = max((len(n) for n, _ in parsed), default=0)
    for name, d in parsed:
        if d is None:
            print(f'{name:<{w}}  ⬜ 无质量追踪记录')
        else:
            print(f"{name:<{w}}  {d.get('status', '?'):<10} {d.get('rating', '?'):<6} last_used={d.get('last_used', '?'):<11} uses={d.get('total_uses', '?')}")
    print(f'\n共 {len(parsed)} 个，{len(missing)} 个缺使用记录')


def cmd_drift(args):
    """对比 已安装副本 vs 仓库当前源 vs 上次交付基线，标出漂移/冲突。"""
    if not args.to:
        sys.exit('drift 需要 --to <目录>（可逗号分隔多个）')
    targets = [t.strip() for t in args.to.split(',') if t.strip()]
    all_skills = load_skills()
    by_name = {s['dir']: s for s in all_skills}
    want = {s['dir'] for s in all_skills if matches(s, args)} if (args.skills or args.platform or args.category) else None

    log_entries = []
    if LOG_FILE.exists():
        for line in LOG_FILE.read_text(encoding='utf-8').splitlines():
            if line.strip():
                log_entries.append(json.loads(line))

    any_conflict = False
    for target in targets:
        tpath = Path(target).expanduser().resolve()
        names = set(want) if want is not None else set()
        if want is None:
            if tpath.exists():
                names |= {d.name for d in tpath.iterdir() if d.is_dir() and d.name in by_name}
            for e in log_entries:
                if e.get('action') == 'export' and e.get('target') == str(tpath):
                    names |= set(e.get('hashes', {}).keys())
        if not names:
            print(f'{target}: 无可比对技能（本地无目录、也无交付记录）')
            continue

        print(f'\n== {target} ==')
        for name in sorted(names):
            if name not in by_name:
                print(f'  {name}: ⚠️  仓库中已不存在该技能')
                continue

            baseline, tool = None, None
            for e in log_entries:
                if e.get('action') == 'export' and e.get('target') == str(tpath):
                    h = e.get('hashes', {}).get(name)
                    if h:
                        baseline, tool = h, e.get('tool')

            installed_dir = tpath / name
            installed_hash = hash_dir(installed_dir) if installed_dir.exists() else None

            with tempfile.TemporaryDirectory() as td:
                tmp_skill = Path(td) / name
                shutil.copytree(by_name[name]['path'], tmp_skill)
                skill_md = tmp_skill / 'SKILL.md'
                if skill_md.exists():
                    render_for_tool(skill_md, parse_overlays(by_name[name]['path'] / 'SKILL.md'), tool)
                source_hash = hash_dir(tmp_skill)

            if installed_hash is None:
                print(f'  {name}: ⬜ 未安装到该目录')
            elif baseline is None:
                print(f'  {name}: ' + ('✅ 一致（无交付基线，按内容比对）' if installed_hash == source_hash else 'ℹ️  内容不同，且无交付基线，无法判断方向'))
            elif installed_hash == baseline and source_hash == baseline:
                print(f'  {name}: ✅ 一致')
            elif installed_hash != baseline and source_hash == baseline:
                print(f'  {name}: ⚠️  本地已改动（安装副本偏离仓库基线）')
            elif installed_hash == baseline and source_hash != baseline:
                print(f'  {name}: 🔄 仓库已更新，建议重新 export')
            else:
                print(f'  {name}: ❌ 冲突（本地和仓库都变了，需人工核对）')
                any_conflict = True

    sys.exit(1 if any_conflict else 0)


def cmd_log(args):
    if not LOG_FILE.exists():
        print('暂无交付记录'); return
    lines = LOG_FILE.read_text(encoding='utf-8').strip().splitlines()
    for line in lines[-args.tail:]:
        e = json.loads(line)
        print(f"{e['ts']}  {e['by']}  {len(e['skills'])} 个技能 → {e['target']}")
        print('   ', ', '.join(e['skills']))


def main():
    ap = argparse.ArgumentParser(prog='skills-cli', description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = ap.add_subparsers(dest='cmd', required=True)

    def add_filters(p):
        p.add_argument('--platform', choices=PLATFORMS)
        p.add_argument('--category', choices=CATEGORIES)
        p.add_argument('--skills', help='逗号分隔的技能名（精确指定，忽略其他筛选）')
        p.add_argument('--strict', action='store_true', help='平台筛选时不自动包含 shared 技能')

    p = sub.add_parser('list', help='列出/筛选技能'); add_filters(p)
    p.add_argument('--json', action='store_true'); p.set_defaults(fn=cmd_list)

    p = sub.add_parser('export', help='定向导出到目录或 zip，并记录交付台账'); add_filters(p)
    p.add_argument('--to', help='目标目录，逗号分隔可一次导出多个（如 ~/.claude/skills,.codex/skills）')
    p.add_argument('--zip', help='打包为 zip 文件')
    p.add_argument('--tool', help='目标 Agent 工具名（如 claude/codex/cursor），套用 frontmatter 里 overlays.<tool> 的覆盖字段；不传则只剥离 overlays 声明块')
    p.add_argument('--no-log', action='store_true', help='本次不写交付台账')
    p.set_defaults(fn=cmd_export)

    p = sub.add_parser('check', help='入库规范校验（SKILL-SPEC 执行器），含质量追踪 JSON 校验'); add_filters(p)
    p.set_defaults(fn=cmd_check)

    p = sub.add_parser('stats', help='使用记录总览：按 last_used 排序，标出缺质量追踪的技能'); add_filters(p)
    p.add_argument('--json', action='store_true'); p.set_defaults(fn=cmd_stats)

    p = sub.add_parser('drift', help='对比已安装副本 vs 仓库源 vs 交付基线，检测漂移/冲突'); add_filters(p)
    p.add_argument('--to', help='已安装目录，逗号分隔可一次检查多个（必填）')
    p.set_defaults(fn=cmd_drift)

    p = sub.add_parser('log', help='查看交付台账')
    p.add_argument('--tail', type=int, default=20); p.set_defaults(fn=cmd_log)

    args = ap.parse_args()
    args.fn(args)


if __name__ == '__main__':
    main()
